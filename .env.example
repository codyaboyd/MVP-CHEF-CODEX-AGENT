NODE_ENV=development
PORT=3000
DATABASE_PATH=./data/mvp-chef-codex.sqlite
APP_NAME=MVP Chef Codex
# Optional colon-separated roots exposed by the server folder browser.
# PROJECT_BROWSER_ROOTS=/home/chef/Documents:/home/chef/Desktop:/home/chef/Downloads

# Wait 5 minutes before retrying a failed Codex prompt step.
CODEX_RETRY_DELAY_MS=300000

# Bounded worker output and SQLite display-log tails (bytes).
CODEX_STDOUT_MEMORY_TAIL_BYTES=262144
CODEX_STDERR_MEMORY_TAIL_BYTES=131072
CODEX_STEP_LOG_MAX_BYTES=2097152
CODEX_LOG_FLUSH_BYTES=65536
CODEX_LOG_FLUSH_INTERVAL_MS=250

# Linux Codex process-tree watchdog. The default is 50% of RAM, clamped to
# 512–8192 MB. Set 0 to disable, or set an explicit per-worker limit in MB.
# CODEX_MAX_PROCESS_TREE_RSS_MB=2048
CODEX_MEMORY_POLL_INTERVAL_MS=1000
CODEX_KILL_GRACE_MS=2000
# Set to 1 for launch/cleanup Node and worker memory diagnostics.
CODEX_MEMORY_TELEMETRY=0
