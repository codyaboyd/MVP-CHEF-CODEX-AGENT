<%- include('partials/layout') %>
<% const currentlyRunning = runs.filter((run) => run.status === 'running'); %>
<section class="codex-home container py-5">
  <div class="codex-intro text-center mx-auto">
    <span class="codex-mark" aria-hidden="true">⌁</span>
    <h1>What do you want to build?</h1>
    <p>Choose a folder, describe the work, and let Codex apply it. Add more prompts when the work needs multiple steps.</p>
  </div>

  <form method="post" action="/run" class="prompt-composer mx-auto" data-quick-run-form>
    <% if (composerErrors.length) { %>
      <div class="alert alert-danger mb-3" role="alert">
        <% composerErrors.forEach((error) => { %><div><%= error %></div><% }) %>
      </div>
    <% } %>

    <div class="folder-picker-row">
      <span aria-hidden="true">📁</span>
      <input class="folder-path-input" name="folderPath" value="<%= composer.folderPath %>" placeholder="Select a folder or paste its absolute path" required data-project-path>
      <button class="btn btn-light btn-sm" type="button" data-folder-browser-button>Browse folders</button>
      <button class="btn btn-light btn-sm" type="button" data-folder-creator-button>Create new</button>
    </div>
    <input class="form-control form-control-sm folder-browser-search" type="search" placeholder="Type to search folders…" aria-label="Search server project folders" hidden data-folder-browser-search>
    <select class="form-select form-select-sm folder-browser" aria-label="Server project folders" hidden data-folder-browser></select>
    <div class="row g-2 mt-1" hidden data-folder-creator><div class="col-md-7"><input class="form-control form-control-sm" aria-label="Parent folder" placeholder="Parent folder (absolute path)" data-folder-parent></div><div class="col-md-3"><input class="form-control form-control-sm" aria-label="New directory name" placeholder="New directory name" data-folder-name></div><div class="col-md-2"><button class="btn btn-success btn-sm w-100" type="button" data-folder-create-submit>Create</button></div></div>
    <p class="folder-hint" data-quick-folder-status>Codex works directly in this folder.</p>

    <div class="prompt-chain" data-prompt-chain>
      <% composer.prompts.forEach((prompt, index) => { %>
        <div class="prompt-chain-item" data-prompt-chain-item>
          <span class="prompt-index"><%= index + 1 %></span>
          <textarea name="prompts" rows="3" placeholder="Ask Codex to build, fix, explain, or automate something…" required><%= prompt %></textarea>
          <button class="prompt-remove" type="button" aria-label="Remove prompt" data-remove-prompt>×</button>
        </div>
      <% }) %>
    </div>

    <div class="composer-actions">
      <button class="btn btn-link" type="button" data-add-prompt>＋ Add another prompt</button>
      <button class="btn btn-dark rounded-pill px-4" type="submit">Run with Codex <span aria-hidden="true">↑</span></button>
    </div>
  </form>

  <div class="quick-notes mx-auto">
    <span>⌘ Runs locally</span><span>↳ Prompts run in order</span><span>◌ Review every change</span>
  </div>

  <% if (currentlyRunning.length) { %>
    <section class="recent-work mx-auto mt-5">
      <div class="d-flex justify-content-between align-items-center mb-3"><h2>Running now <span class="active-run-count"><%= currentlyRunning.length %></span></h2><a href="/runs">View all runs</a></div>
      <% currentlyRunning.forEach((run) => { %>
        <a class="recent-run" href="/runs/<%= run.id %>">
          <span>
            <strong><%= run.recipe_name %></strong>
            <small><%= run.project_name %></small>
            <% if (run.status === 'running' && run.stepProgress) { %>
              <small class="recent-run-step">Step <%= run.stepProgress.current %> of <%= run.stepProgress.total %> · <%= run.stepProgress.title %></small>
            <% } %>
          </span>
          <span class="status-badge" data-status="<%= run.status %>"><%= run.status %></span>
        </a>
      <% }) %>
    </section>
  <% } else { %>
    <section class="recent-work mx-auto mt-5 text-center empty-active-runs">
      <h2>No jobs running right now</h2>
      <p class="text-muted mb-2">Start a task above or review previous work.</p>
      <a href="/runs">View all runs</a>
    </section>
  <% } %>
</section>
<%- include('partials/footer') %>
